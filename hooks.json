{
  "remote-mutation-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/guard-remote-mutation.mjs --harness=antigravity"
          }
        ]
      }
    ]
  },
  "symlinked-node-modules-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/guard-symlinked-node-modules.mjs --harness=antigravity"
          }
        ]
      }
    ]
  },
  "main-checkout-edits-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/guard-main-checkout-edits.mjs --harness=antigravity"
          }
        ]
      }
    ]
  }
}
