#!/usr/bin/env bash
# Enforces the session-per-worktree workflow:
#   1. The main checkout only accepts merge commits onto `main`/`master`
#      (and the initial commit on an unborn repository). Direct commits and
#      feature work belong in linked worktrees.
#   2. Linked worktrees must not commit on `main`/`master` directly.

set -euo pipefail

git_dir="$(git rev-parse --path-format=absolute --git-dir)"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"

# Initial commit on an unborn repository is always allowed in the main checkout.
if ! git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  exit 0
fi

branch="$(git symbolic-ref --short -q HEAD || true)"

if [[ "$git_dir" == "$common_dir" ]]; then
  # In the main checkout, only merge commits onto main/master are allowed,
  # except for documentation-only commits verified by doc linters.
  if [[ ( "$branch" == "main" || "$branch" == "master" ) && -f "$git_dir/MERGE_HEAD" ]]; then
    exit 0
  fi

  # Check if all staged files are documentation or planning files.
  staged_files="$(git diff --cached --name-only)"
  is_doc_only=1
  has_files=0
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    has_files=1
    if [[ "$file" != docs/* && "$file" != "README.md" ]]; then
      is_doc_only=0
      break
    fi
  done <<< "$staged_files"

  if [[ "$is_doc_only" -eq 1 && "$has_files" -eq 1 ]]; then
    repo_root="$(git rev-parse --show-toplevel)"
    NODE_BIN="${NODE:-}"
    if [[ -z "$NODE_BIN" ]] || ! command -v "$NODE_BIN" >/dev/null 2>&1; then
      NODE_BIN="$(command -v node || true)"
    fi
    if [[ -z "$NODE_BIN" && -d "$HOME/.nvm/versions/node" ]]; then
      latest_nvm="$(ls -d "$HOME/.nvm/versions/node/"* 2>/dev/null | sort -V | tail -n1 || true)"
      if [[ -n "$latest_nvm" && -x "$latest_nvm/bin/node" ]]; then
        NODE_BIN="$latest_nvm/bin/node"
      fi
    fi

    if [[ -f "$repo_root/scripts/check-doc-links.mjs" && -n "$NODE_BIN" && -x "$NODE_BIN" ]]; then
      echo "pre-commit: verifying doc links and formatting on main checkout..." >&2
      "$NODE_BIN" "$repo_root/scripts/check-doc-links.mjs" "$repo_root"
      if [[ -f "$repo_root/scripts/reflow-docs.mjs" ]]; then
        "$NODE_BIN" "$repo_root/scripts/reflow-docs.mjs" "$repo_root" --check
      fi
    elif command -v rig >/dev/null 2>&1; then
      echo "pre-commit: verifying doc links and formatting via rig..." >&2
      rig check-docs "$repo_root"
      rig reflow-docs "$repo_root" --check
    fi
    exit 0
  fi

  echo "pre-commit: refusing direct commit in the main checkout." >&2
  echo "The main checkout only accepts merge commits or doc-only commits on main/master." >&2
  echo "Create or enter a linked git worktree first (e.g. git worktree add .worktrees/<slug> -b <type>/<slug>)." >&2
  exit 1
fi

# In a linked worktree, main/master should never receive direct commits.
if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  echo "pre-commit: refusing to commit on '$branch' in a linked worktree." >&2
  echo "main remains attached in the main checkout; merge feature branches from there via merge-to-main." >&2
  exit 1
fi
